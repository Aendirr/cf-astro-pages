---
interface Props {
  url?: string | null;
  text?: string | null;
  color?: string | null;
  size?: 'md' | 'lg';
}

const { url, text, color, size = 'md' } = Astro.props;

const background = color && /^#[0-9a-fA-F]{6}$/.test(color) ? color : '#facc15';
const r = parseInt(background.slice(1, 3), 16);
const g = parseInt(background.slice(3, 5), 16);
const b = parseInt(background.slice(5, 7), 16);
const foreground = r * 0.299 + g * 0.587 + b * 0.114 > 150 ? '#111111' : '#ffffff';
const sizeClass = size === 'lg' ? 'px-8 py-4 text-lg' : 'px-6 py-3 text-base';
---

{url && (
  <a
    href={url}
    target="_blank"
    rel="nofollow sponsored noopener"
    class={`inline-flex items-center gap-2 rounded-full font-bold shadow-md transition-transform hover:-translate-y-0.5 ${sizeClass}`}
    style={`background-color:${background};color:${foreground}`}
  >
    {text || 'Siteye Git'}
    <span aria-hidden="true">→</span>
  </a>
)}
